# =============================================================================
# Environment Configuration - Simple DRF Blog
# =============================================================================
# Copy this file to .env and fill in the values.
#
# Annotations:
# (required)    - must be set in the named environment
# (optional)    - has a sensible default; override if needed
# (conditional) - required only when a related feature is enabled
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# (required - prod) (optional - dev, test)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# (required - prod) (optional - dev, test — falls back to SECRET_KEY)
# Dedicated JWT HS256 signing key. Keeping it separate from SECRET_KEY lets
# you revoke all tokens (restart with a new value) without touching Django
# sessions/signed cookies. Never reuse the SECRET_KEY value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SIGNING_KEY=change-me-to-a-second-long-random-string

# (required - prod)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# (optional - prod defaults 1, dev/test default 0)
# Number of reverse proxies in front of the app; used to resolve the client
# IP from X-Forwarded-For. 1 matches the included nginx setup.
NUM_PROXIES=1

# (optional - prod defaults True, dev/test default False)
# Delegates the downloading of private or static files to a front-end web server
# USE_X_ACCEL_REDIRECT = True

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# (required - prod, dev) MariaDB Docker image creates this database on init.
MARIADB_DATABASE=dbname

# (required - prod, dev) MariaDB Docker image creates this user on init.
MARIADB_USER=user

# (required - prod, dev) Must match the password in DATABASE_URL.
MARIADB_PASSWORD=password

# (required - prod, dev) Root password for the MariaDB container.
MARIADB_ROOT_PASSWORD=change-me-root-password

# -----------------------------------------------------------------------------
# Redis & Celery
# -----------------------------------------------------------------------------
# Separate Redis databases: Broker (0), Results (1), Cache (2)
#
# (required - prod) (optional - dev, prod-style values shown; dev defaults
# are the same URLs without a password)
# NOTE: the password embedded in these URLs must match REDIS_PASSWORD.
CELERY_BROKER_URL=redis://:change-me-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-redis-password@redis:6379/1
CACHE_URL=redis://:change-me-redis-password@redis:6379/2

# (optional - prod defaults 300, dev defaults 5)
# Deduplication window (seconds) for post-view tracking.
POST_VIEW_DEDUP_TTL=300

# (required - prod, dev) Password for the Redis container.
REDIS_PASSWORD=change-me-redis-password

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
# (optional - empty string disables Sentry)
SENTRY_DSN=

# (optional - defaults to "production")
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Metadata
# -----------------------------------------------------------------------------
# (optional - defaults to "1.0")
API_VERSION=1.0
