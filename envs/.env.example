# =============================================================================
# Environment Configuration - Simple DRF Blog
# =============================================================================
# Copy this file to .env.dev / .env.prod / .env.test and fill in the values.
#
# Annotations:
# (required)    - must be set in the named environment
# (optional)    - has a sensible default; override if needed
# (conditional) - required only when a related feature is enabled
#
# IMPORTANT (Docker Compose):
#    Values containing '$' must be escaped as '$$' in .env files loaded via
#    docker-compose `env_file`, e.g. SECRET_KEY=abc$$def -> abd$def
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# (required - prod) (optional - dev, test)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# (optional - dev defaults True, prod, test defaults False)
DEBUG=False

# (required - prod)
ALLOWED_HOSTS=*

# (required - prod, dev) (optional - test, defaults to SQLite)
# The password in DATABASE_URL MUST match database credentials in
# .env.example.db
DATABASE_URL=mysql://user:password@db:3306/dbname

# -----------------------------------------------------------------------------
# Redis & Celery
# -----------------------------------------------------------------------------
# Separate Redis databases: Broker (0), Results (1), Cache (2)
#
# (required - prod) (optional - dev, defaults shown)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2

# (optional - prod defaults 300, dev defaults 5)
# Deduplication window (seconds) for post-view tracking.
POST_VIEW_DEDUP_TTL=300

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# (optional - defaults to "local")
# Values: local | s3 | gcs
MEDIA_STORAGE_BACKEND=local

# S3 (conditional — required when MEDIA_STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# GCS (conditional — required when MEDIA_STORAGE_BACKEND=gcs)
GS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=  # absolute path to service-account JSON inside
# the container

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
# (optional - empty string disables Sentry)
SENTRY_DSN=

# (optional - defaults to "production")
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Metadata
# -----------------------------------------------------------------------------
# (optional - defaults to "1.0")
API_VERSION=1.0
